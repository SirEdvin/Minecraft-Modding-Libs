{
  "schemaVersion": 1,
  "id": "peripheralium",
  "version": "${version}",
  "name": "Peripheralium",
  "description": "A basic mod for modding libs test",
  "authors": [
    "SirEdvin"
  ],
  "accessWidener": "peripheralium.accesswidener",
  "contact": {
    "homepage": "https://github.com/SirEdvin/Minecraft-Modding-Libs",
    "issues": "https://github.com/SirEdvin/Minecraft-Modding-Libs/issues",
    "sources": "https://github.com/SirEdvin/Minecraft-Modding-Libs"
  },
  "license": "MIT",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.peripheralium.FabricPeripheralium"
      }
    ],
    "fabric-datagen": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.peripheralium.PeripheraliumDataGenerator"
      }
    ]
  },
  "mixins": [
  ],
  "depends": {
    "fabricloader": "*",
    "fabric": "*",
    "fabric-language-kotlin": "*",
    "minecraft": ">=1.21 <1.22",
    "java": ">=17",
    "computercraft": ">=${computercraftVersion}",
    "broccolium": ">=${broccoliumVersion}",
    "tweakium": ">=${tweakiumVersion}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/dYHKMQYRPp"
      },
      "badges": ["library"]
    }
  }
}
