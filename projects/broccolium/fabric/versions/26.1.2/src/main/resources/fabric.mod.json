{
  "schemaVersion": 1,
  "id": "broccolium",
  "version": "${version}",
  "name": "Broccolium",
  "description": "A library for all of my mods, actually",
  "authors": ["SirEdvin"],
  "accessWidener": "broccolium.accesswidener",
  "contact": {
    "homepage": "https://github.com/SirEdvin/Minecraft-Modding-Libs",
    "issues": "https://github.com/SirEdvin/Minecraft-Modding-Libs/issues",
    "sources": "https://github.com/SirEdvin/Minecraft-Modding-Libs"
  },
  "license": "MIT",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [{"adapter": "kotlin", "value": "site.siredvin.broccolium.FabricBroccolium"}],
    "client": [{"adapter": "kotlin", "value": "site.siredvin.broccolium.FabricBroccoliumClient"}],
    "fabric-datagen": [{"adapter": "kotlin", "value": "site.siredvin.broccolium.modules.data.LibDataGenerator"}]
  },
  "mixins": ["broccolium.mixins.json", "broccolium-common.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.155.3+26.1.2",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0",
    "minecraft": "26.1.2",
    "java": ">=25"
  },
  "custom": {
    "modmenu": {
      "links": {"modmenu.discord": "https://discord.gg/dYHKMQYRPp"},
      "badges": ["library"]
    }
  }
}
