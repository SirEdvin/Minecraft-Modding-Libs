{
  "schemaVersion": 1,
  "id": "broccolium",
  "version": "${version}",
  "name": "Broccolium",
  "description": "A library for all of my mods, actually",
  "authors": [
    "SirEdvin"
  ],
  "accessWidener": "broccolium.accesswidener",
  "contact": {
    "homepage": "https://github.com/SirEdvin/Minecraft-Modding-Libs",
    "issues": "https://github.com/SirEdvin/Minecraft-Modding-Libs/issues",
    "sources": "https://github.com/SirEdvin/Minecraft-Modding-Libs"
  },
  "license": "MIT",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.broccolium.FabricBroccolium"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.broccolium.FabricBroccoliumClient"
      }
    ],
    "fabric-datagen": [
      {
        "adapter": "kotlin",
        "value": "site.siredvin.broccolium.modules.data.LibDataGenerator"
      }
    ]
  },
  "mixins": [
    "broccolium.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "fabric": "*",
    "fabric-language-kotlin": "*",
    "minecraft": ">=1.20 <1.21",
    "java": ">=17"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/dYHKMQYRPp"
      },
      "badges": ["library"]
    }
  }
}
